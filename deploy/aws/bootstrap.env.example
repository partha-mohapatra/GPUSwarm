# Copy this file to deploy/aws/bootstrap.env and edit values as needed.

# AWS auth and target
AWS_PROFILE=dsm
AWS_REGION=us-east-1
STACK_NAME=infermesh-bootstrap

# Template + artifact
TEMPLATE_FILE=deploy/aws/infermeshd-bootstrap-full.cfn.yaml
BINARY_PATH=dist/infermeshd-linux-amd64
S3_BUCKET=
PRESIGN_TTL=604800
INFERMESHD_DOWNLOAD_URL=

# Optional stack params
INSTANCE_TYPE=t3.micro
ALLOWED_SSH_CIDR=0.0.0.0/0
LIBP2P_PORT=39001
RENDEZVOUS=infermesh-rendezvous
BOOTSTRAP_PEERS=
VPC_ID=
SUBNET_ID=
SUBNET_AZ=
EXISTING_KEY_NAME=
KEY_PAIR_NAME=infermesh-bootstrap-key
AMI_ID=

# Optional local infermeshd config to update with discovered bootstrap peer
LOCAL_CONFIG_PATH=

# Optional nightly auto-stop window (UTC) for manage-bootstrap.sh set-night-stop
NIGHTLY_STOP_UTC_HOUR=23
NIGHTLY_STOP_UTC_MINUTE=0

# Key pair export (for stack-created keys only)
EXPORT_CREATED_KEYPAIR=true
KEY_OUTPUT_DIR=deploy/aws/keys
